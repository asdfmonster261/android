<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <include name="default.xml" />

  <!-- Pixel 11 Pro Fold (yogi) -->
  <project path="device/google/yogi" name="asdfmonster261/android_device_google_yogi" revision="lineage-24.0" />
  <project path="vendor/google/yogi" name="asdfmonster261/android_vendor_google_yogi" revision="lineage-24.0" />
  <project path="device/google/yogi-kernels" name="asdfmonster261/android_device_google_yogi-kernels" revision="lineage-24.0" />

  <!-- libjxl and libdng_sdk are vendor_available on this branch, but the static libraries
       they pull in are not, on the android-17.0.0_r1 tag these projects are pinned to, so
       their vendor variants fail to resolve and no product completes soong analysis. -->
  <remove-project name="platform/external/google-highway" />
  <project path="external/google-highway" name="asdfmonster261/android_external_google-highway" revision="lineage-24.0" />
  <remove-project name="platform/external/XMP-Toolkit-SDK" />
  <project path="external/XMP-Toolkit-SDK" name="asdfmonster261/android_external_XMP-Toolkit-SDK" revision="lineage-24.0" />
  <remove-project name="platform/external/skia" />
  <project path="external/skia" name="asdfmonster261/android_external_skia" revision="lineage-24.0" />

  <!-- The ISO9660/UDF volume manager work picked into 24.0 uses std::replace and
       std::vector without including them, which the A17 toolchain libc++ headers no
       longer provide transitively, so neither repo compiles. -->
  <remove-project name="LineageOS/android_bootable_recovery" />
  <project path="bootable/recovery" name="asdfmonster261/android_bootable_recovery" groups="pdk" revision="lineage-24.0" />
  <remove-project name="LineageOS/android_system_vold" />
  <project path="system/vold" name="asdfmonster261/android_system_vold" groups="pdk" revision="lineage-24.0" />

  <!-- avbtool cannot verify an ML-DSA signature: it hexes a bytes object, and its key
       size check compares a key the decoder has already stripped the length header from
       against a constant that includes it. Both are upstream, android17-release included. -->
  <remove-project name="LineageOS/android_external_avb" />
  <project path="external/avb" name="asdfmonster261/android_external_avb" groups="pdk" revision="lineage-24.0" />

</manifest>
