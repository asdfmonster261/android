<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <include name="default.xml" />

  <!-- Pixel 11 Pro Fold (yogi) -->
  <project path="device/google/yogi" name="asdfmonster261/android_device_google_yogi" revision="lineage-24.0" />
  <project path="vendor/google/yogi" name="asdfmonster261/android_vendor_google_yogi" revision="lineage-24.0" />
  <project path="device/google/yogi-kernels" name="asdfmonster261/android_device_google_yogi-kernels" revision="lineage-24.0" />

  <!-- The rest of the Pixel 11 family: the malibu tree carries everything the four
       phones share, and each device adds its own thin tree, blobs and kernels. -->
  <project path="device/google/malibu" name="asdfmonster261/android_device_google_malibu" revision="lineage-24.0" />
  <project path="device/google/kodiak" name="asdfmonster261/android_device_google_kodiak" revision="lineage-24.0" />
  <project path="vendor/google/kodiak" name="asdfmonster261/android_vendor_google_kodiak" revision="lineage-24.0" />
  <project path="device/google/kodiak-kernels" name="asdfmonster261/android_device_google_kodiak-kernels" revision="lineage-24.0" />
  <project path="device/google/grizzly" name="asdfmonster261/android_device_google_grizzly" revision="lineage-24.0" />
  <project path="vendor/google/grizzly" name="asdfmonster261/android_vendor_google_grizzly" revision="lineage-24.0" />
  <project path="device/google/grizzly-kernels" name="asdfmonster261/android_device_google_grizzly-kernels" revision="lineage-24.0" />

  <!-- The ISO9660/UDF volume manager work picked into 24.0 uses std::replace and
       std::vector without including them, which the A17 toolchain libc++ headers no
       longer provide transitively, so neither repo compiles. -->
  <remove-project name="LineageOS/android_bootable_recovery" />
  <project path="bootable/recovery" name="asdfmonster261/android_bootable_recovery" groups="pdk" revision="lineage-24.0" />
  <remove-project name="LineageOS/android_system_vold" />
  <project path="system/vold" name="asdfmonster261/android_system_vold" groups="pdk" revision="lineage-24.0" />

  <!-- avbtool cannot verify an ML-DSA signature: it hexes a bytes object, and its key
       size check compares a key the decoder has already stripped the length header from
       against a constant that includes it. Both are upstream, android17-release included. -->
  <remove-project name="LineageOS/android_external_avb" />
  <project path="external/avb" name="asdfmonster261/android_external_avb" groups="pdk" revision="lineage-24.0" />

  <!-- The LineageOS notification lights patch dereferences mLineageNotificationLights
       from updateLightsLocked(), which the LedUpdater callback re-enters from the
       LineageNotificationLights constructor, before that field has been assigned.
       system_server dies in NotificationManagerService.onStart() and init reboots once
       zygote has failed four times. Only fires with favorites_incoming_call_lights on,
       which is why upstream has not hit it. -->
  <remove-project name="LineageOS/android_frameworks_base" />
  <project path="frameworks/base" name="asdfmonster261/android_frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" revision="lineage-24.0" />

  <!-- OpenEUICC, an lpa that needs no gms. Ours lowers the EuiccService intent-filter
       priority so a stock lpa wins where one is installed and enabled, and commits the
       zxing aar upstream leaves to a gradle step. lpac and cJSON are its submodules,
       pinned to the commits the fork records, since repo does not follow submodules. -->
  <project path="packages/apps/OpenEUICC" name="asdfmonster261/openeuicc" revision="lineage-24.0" />
  <project path="packages/apps/OpenEUICC/libs/lpac-jni/src/main/jni/lpac" name="estkme-group/lpac" revision="50cdf15ab40942b00f8819a1c2ca19997f1a6d34" />
  <project path="packages/apps/OpenEUICC/libs/lpac-jni/src/main/jni/cjson/cjson" name="DaveGamble/cJSON" revision="6d9f2443ab071f86e5d9b43025a40929ec41c46c" />

  <!-- EuiccSupportPixel's OTA jobs keep starting a process whose OtaApplication dies
       registering its gservices observer, so without gms it drips crash reports
       indefinitely. Ours adds it to the packages the disabler parks until gms returns. -->
  <remove-project name="LineageOS/android_packages_apps_EuiccPolicy" />
  <project path="packages/apps/EuiccPolicy" name="asdfmonster261/android_packages_apps_EuiccPolicy" revision="lineage-24.0" />

</manifest>
